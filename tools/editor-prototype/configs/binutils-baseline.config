# binutils-baseline — R0, every rendering feature off.
# The reference point: the listing reads exactly as `objdump` prints it
# (mnemonic + one space + operands, "// comment" on the same line). Edit any
# key up from here to feel a single feature in isolation.
# Format: `key = value`, `#` starts a comment, blank lines ignored.

# Palette: 4 SAM CLUT register values (0-127) the code rows share (MODE 3 shows
# one 4-colour quadruple). clut[0..3] are the pens roles resolve to.
clut = 0, 15, 102, 127      # black / mid-grey / bright-yellow / bright-white
role_paper = 0
role_code = 3
role_comment = 1
role_label = 3
role_register_mark = 2      # accent pen for register marking
role_immediate_mark = 2     # accent pen for the mark-immediates alternative
role_chrome_fg = 0          # status-bar text
role_chrome_bg = 3          # status-bar background
role_current_line = 1       # current-line highlight band
role_status = 0             # status text pen
relax_palette = off         # on = unlimited terminal colours, no SAM PNG

# Mnemonic column: adaptive (per-page longest mnemonic + 1) or fixed:N.
# fixed:0 = R0 (one space after the mnemonic).
mnemonic_column = fixed:0

# Immediates (separately toggleable): #0x1F -> &1F ; decimal #16 -> 16.
imm_hex_amp = off
imm_drop_hash = off

# Separators: ", " -> "," in operand lists.
tight_commas = off

# Registers. reg_style off keeps x23/w5; strip drops the prefix (x23 -> 23) and
# colour carries the register-ness. Per-class marking = none|fg|bg|inverse.
reg_style = off
reg_x_style = none
reg_w_style = none
reg_named_style = none       # sp / lr / fp / xzr / wzr / wsp
# Alternative to flooding every register: mark the rarer immediate class.
mark_immediates = off
mark_immediates_style = none

# Labels. label_truncate off | N: branch/adr targets longer than N truncate to
# N chars (+ ellipsis glyph when label_ellipsis = on).
label_truncate = off
label_ellipsis = on

# Comments. layout sameline | above | marker-only. comment_column page (column
# clears all code) | commented-lines-only (clears only comment-carrying code).
comment_layout = sameline
comment_gap = 2
comment_semicolon = off
comment_column = page

# Cursor-line expansion: off | wrap:K (cursor line unfolds inline, page shifts)
# | panel:K (K reserved bottom rows show the cursor line's full comment).
expand_cursor_line = off

# Viewport: wrap on/off; viewport_step = horizontal-shift cells when wrap off.
wrap = on
viewport_step = 8

# Chrome. current_line_highlight = full-width band. status_line template fields:
# {file} {line} {total} {pct} {mode}. status_message = optional 2nd line.
current_line_highlight = off
status_line = {file}  L{line}/{total}  {pct}  {mode}

# R6: collapse spaces in parenthesised expressions. When imm_hex_amp is on the
# '&' AND operator is drawn as a distinct wedge glyph (the '&' sigil is hex).
tighten_exprs = off
