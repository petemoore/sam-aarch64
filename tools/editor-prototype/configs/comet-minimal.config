# comet-minimal — a chromeless homage to the COMET assembler's spare screen.
# No status decoration to speak of, no register marks, semicolon comments in the
# 1980s convention. The instruction stays close to its source spelling; the
# screen is code and comment, nothing else competing for the eye.

clut = 0, 15, 96, 120       # black / grey / yellow / white (slightly softer whites)
role_paper = 0
role_code = 3
role_comment = 1
role_label = 3
role_register_mark = 2
role_immediate_mark = 2
role_chrome_fg = 0
role_chrome_bg = 3
role_current_line = 1
role_status = 0
relax_palette = off

mnemonic_column = adaptive

imm_hex_amp = on
imm_drop_hash = off          # keep the '#' so immediates read as the source did

tight_commas = off

reg_style = off              # registers keep their names; no colour flooding
reg_x_style = none
reg_w_style = none
reg_named_style = none
mark_immediates = off
mark_immediates_style = none

label_truncate = off
label_ellipsis = on

comment_layout = sameline
comment_gap = 2
comment_semicolon = on       # ; comments, the era convention
comment_column = page

expand_cursor_line = off

wrap = on
viewport_step = 8

current_line_highlight = off  # no band — minimal chrome
status_line = {file}  {line}/{total}

# Max instruction width: off | N.
# The FORMAT never imposes line-length limits — anything binutils accepts must
# round-trip cleanly; overflow is a display concern (collapse/expand). Hard
# format limits are an absolute last resort, effectively never. (Pete, 2026-06-12)
max_instruction_width = off

# Constant base rendering: source | hex | dec.
render_constants = source
