# dreamer — relax_palette on: dream in unlimited terminal colours.
# The 4-colour MODE 3 ceiling is lifted, so roles may index the full 16-entry
# CLUT and each render role gets its own distinct colour. The status bar
# permanently shows OFF-SAM PALETTE, and this config cannot render a SAM PNG
# (-sam-png refuses it) — it is for exploring a palette before constraining it
# back down to four. Dream first, constrain after.

clut = 0, 16, 32, 64        # the first four base colours; roles below reach past them
role_paper = 0              # black
role_code = 7               # white
role_comment = 5            # cyan
role_label = 13             # bright cyan
role_register_mark = 14     # bright yellow
role_immediate_mark = 10    # bright red
role_chrome_fg = 0          # black on...
role_chrome_bg = 12         # ...bright green
role_current_line = 9       # bright blue band
role_status = 7             # white status text
relax_palette = on

mnemonic_column = adaptive

imm_hex_amp = on
imm_drop_hash = on

tight_commas = on

reg_style = strip
reg_x_style = fg            # registers in their own bright colour
reg_w_style = inverse
reg_named_style = fg
mark_immediates = on        # AND mark immediates in a second accent colour
mark_immediates_style = fg

label_truncate = 16
label_ellipsis = on

comment_layout = sameline
comment_gap = 2
comment_semicolon = off
comment_column = commented-lines-only

expand_cursor_line = panel:4   # a 4-row comment panel pinned to the bottom
expand_only_if_needed = on    # panel appears only when comment won't fit inline
cursor_block_style = band     # expanded rows take the current-line band colour

wrap = on
viewport_step = 8

current_line_highlight = on
status_line = {file}  L{line}/{total}  {pct}  {mode}
status_message = dreaming in colour - constrain to 4 pens to render a SAM PNG

# Max instruction width: off | N.
# The FORMAT never imposes line-length limits — anything binutils accepts must
# round-trip cleanly; overflow is a display concern (collapse/expand). Hard
# format limits are an absolute last resort, effectively never. (Pete, 2026-06-12)
max_instruction_width = off

# Constant base rendering: source | hex | dec.
render_constants = source

# Fine syntax-colour roles — dreaming in 16 colours, each token class distinct.
role_mnemonic = 11          # bright-cyan mnemonic (stands out from white operands)
role_expression = 7         # white plain operand text
role_register = 14          # bright-yellow registers (base; reg_style marking overrides)
role_immediate = 10 inverse # bright-red immediates, inverse (strong accent)
