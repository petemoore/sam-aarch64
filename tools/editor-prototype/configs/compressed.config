# compressed — the iteration-2 R5 + refinements recommendation.
# Adaptive mnemonic column, &-hex + dropped-# immediates, tight commas, stripped
# registers with a yellow-bg mark, label truncation at N=16, same-line grey
# comments with no semicolon, a commented-lines-only comment column, and the
# cursor line unfolding to 3 inline rows. This is the "make room for the comment
# by compressing the instruction" direction the measurement report endorsed.

clut = 0, 15, 102, 127
role_paper = 0
role_code = 3
role_comment = 1
role_label = 3
role_register_mark = 2
role_immediate_mark = 2
role_chrome_fg = 0
role_chrome_bg = 3
role_current_line = 1
role_status = 0
relax_palette = off

mnemonic_column = adaptive

imm_hex_amp = on
imm_drop_hash = on

tight_commas = on

reg_style = strip
reg_x_style = bg            # x-width registers: yellow background block
reg_w_style = inverse       # w-width: distinguished by inverse video
reg_named_style = fg        # sp/lr/fp/...: yellow ink, no block
mark_immediates = off       # registers carry the mark here, not immediates
mark_immediates_style = none

label_truncate = 16         # measured: bites 24.1% of branch operands at N=16
label_ellipsis = on

comment_layout = sameline
comment_gap = 2
comment_semicolon = off
comment_column = commented-lines-only   # the report's free +6-points refinement

expand_cursor_line = wrap:3   # cursor line unfolds to <=3 inline rows
expand_only_if_needed = on    # skip expansion when code+comment already fits inline
cursor_block_style = bracket  # heavy left-edge bracket on each expanded row

wrap = on
viewport_step = 8

current_line_highlight = on
status_line = {file}  L{line}/{total}  {pct}  {mode}

tighten_exprs = on

# Max instruction width: off | N. When a rendered code line exceeds N columns
# and it is NOT the cursor line, it truncates at N-1 and appends the ellipsis
# glyph; the cursor line always shows in full (expand_cursor_line handles
# overflow). Same-line comments are suppressed on truncated rows (they float
# against a fake column) and remain reachable via cursor-expansion / F7.
# Width computation for the adaptive mnemonic/comment columns uses
# post-truncation widths so truncated lines do not drag the comment column.
#
# The FORMAT never imposes line-length limits — anything binutils accepts must
# round-trip cleanly; overflow is a display concern (collapse/expand). Hard
# format limits are an absolute last resort, effectively never. (Pete, 2026-06-12)
max_instruction_width = 40

# Constant base rendering: source | hex | dec.
# "source" (default) keeps the source spelling — honest because the v2 format
# carries editor-region base hints. "hex" forces SAM &FFFF (or 0x when
# imm_hex_amp is off). "dec" forces decimal. Composes with imm_hex_amp /
# imm_drop_hash.
render_constants = source

# Fine syntax-colour roles (pen [inverse]). Mnemonic white; registers use the
# reg_style mark pen (reg_style wins when active, role_register is the base).
# Immediates in this config use the accent pen (pen 2, yellow) when
# mark_immediates is off — a subtle immediate accent without flooding registers.
role_mnemonic = 3           # bright-white mnemonic
role_expression = 3         # bright-white plain operand text
role_register = 3           # bright-white base (reg_style marking overrides)
role_immediate = 2          # yellow accent on immediates (tasteful contrast)
