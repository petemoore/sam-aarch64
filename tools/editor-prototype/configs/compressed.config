# compressed — the iteration-2 R5 + refinements recommendation.
# Adaptive mnemonic column, &-hex + dropped-# immediates, tight commas, stripped
# registers with a yellow-bg mark, label truncation at N=16, same-line grey
# comments with no semicolon, a commented-lines-only comment column, and the
# cursor line unfolding to 3 inline rows. This is the "make room for the comment
# by compressing the instruction" direction the measurement report endorsed.

clut = 0, 15, 102, 127
role_paper = 0
role_code = 3
role_comment = 1
role_label = 3
role_register_mark = 2
role_immediate_mark = 2
role_chrome_fg = 0
role_chrome_bg = 3
role_current_line = 1
role_status = 0
relax_palette = off

mnemonic_column = adaptive

imm_hex_amp = on
imm_drop_hash = on

tight_commas = on

reg_style = strip
reg_x_style = bg            # x-width registers: yellow background block
reg_w_style = inverse       # w-width: distinguished by inverse video
reg_named_style = fg        # sp/lr/fp/...: yellow ink, no block
mark_immediates = off       # registers carry the mark here, not immediates
mark_immediates_style = none

label_truncate = 16         # measured: bites 24.1% of branch operands at N=16
label_ellipsis = on

comment_layout = sameline
comment_gap = 2
comment_semicolon = off
comment_column = commented-lines-only   # the report's free +6-points refinement

expand_cursor_line = wrap:3   # cursor line unfolds to <=3 inline rows

wrap = on
viewport_step = 8

current_line_highlight = on
status_line = {file}  L{line}/{total}  {pct}  {mode}

tighten_exprs = on
