{
  "permissions": {
    "allow": [
      "Bash(sudo tcpdump *)",
      "Bash(sudo arping *)",
      "Bash(~/bin/tapo.sh *)",
      "Bash(tapo.sh *)",
      "Bash(DEPLOY_CHECKED=1 python3 tools/trinload-push/trinpush-serve.py *)",
      "Bash(DEPLOY_CHECKED=1 python3 tools/trinload-push/trinload-push.py *)",
      "Bash(DEPLOY_CHECKED=1 tools/trinload-push/trinpush-serve.py *)",
      "Bash(DEPLOY_CHECKED=1 tools/trinload-push/trinload-push.py *)",
      "Bash(curl --max-time * tftp://192.168.2.75/*)",
      "Bash(curl -T * tftp://192.168.2.75/*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/tools/deploy-guard/pre-deploy-check.sh\"",
            "timeout": 10,
            "statusMessage": "SAM deploy-guard: checking for a real-hardware deployment"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/tools/session-handover.sh\" 2>/dev/null || sed -n '/HANDOVER-PROTOCOL-START/,/HANDOVER-PROTOCOL-END/p' \"${CLAUDE_PROJECT_DIR:-.}/docs/ROADMAP.md\" 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Loading ROADMAP handover protocol"
          }
        ]
      }
    ]
  }
}
